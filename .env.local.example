# Supabase — copie do painel do projeto (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui

# Fase 2 (IA) — SOMENTE no servidor, nunca exposta no navegador.
ANTHROPIC_API_KEY=sk-ant-...
# Opcional: trocar o modelo (padrão claude-opus-4-8). Ex.: claude-sonnet-5 para custo/velocidade.
# ANTHROPIC_MODEL=claude-opus-4-8
